# Product app (signup / studio). Landing stays on drumreel.com.
NEXT_PUBLIC_APP_URL=https://app.drumreel.com

# Waitlist storage (required). Added automatically when "Upstash for Redis" is
# connected to the project in Vercel > Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or, for a database created in the Upstash console:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: email each signup via Resend
# RESEND_API_KEY=
# WAITLIST_NOTIFY_EMAIL=hello@drumreel.com
# EMAIL_FROM=Drumreel <noreply@drumreel.com>
